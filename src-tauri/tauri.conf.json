{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuiviT",
  "version": "0.1.0",
  "identifier": "com.x4163.quivit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QuiviT",
        "width": 900,
        "height": 650,
        "minWidth": 400,
        "minHeight": 300,
        "backgroundColor": "#f0f0f0",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
