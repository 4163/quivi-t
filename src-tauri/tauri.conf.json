{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuiviT",
  "version": "1.0.0",
  "identifier": "com.x4163.quivit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "QuiviT Contributors",
    "category": "Photography",
    "shortDescription": "Lightweight comic and manga viewer for Windows",
    "longDescription": "QuiviT is a lightweight standalone port of Quivi, built with Tauri. View images and archives (ZIP/CBZ, RAR/CBR, 7Z/CB7, TAR) with fast browsing, viewer controls, and custom CSS theming.",
    "resources": {
      "../themes/matcha-latte.css": "themes/matcha-latte.css",
      "../themes/sage-mint.css": "themes/sage-mint.css"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
