{
  "name": "tauri-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "node scripts/dev.js",
    "dev:portable": "node scripts/dev.js --portable",
    "mocha": "mocha 'mocha/*.test.js'",
    "e2e": "node scripts/e2e.js --layout portable",
    "e2e:split": "node scripts/e2e.js --layout split",
    "record": "wdio run wdio.conf.js --spec e2e/specs/record.e2e.js",
    "replay": "node e2e/replay-diagnostics/cli.js",
    "diagnose": "node e2e/replay-diagnostics/cli.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.4.0",
    "mocha": "^10.8.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "pica": "^10.0.3"
  }
}
